#!/usr/bin/env bash
set -euo pipefail

# Unstick a Flux HelmRelease stuck in a hung install/upgrade action
# (e.g. "Running 'install' action" forever, with no pod activity).

FLUX_NS="flux-system"
CONTROLLER="helm-controller"
NAMESPACE=""
RELEASE=""
ASSUME_YES="false"
LIST_ONLY="false"
NO_RESTART="false"

usage() {
  cat <<'EOF'
Unstick a Flux HelmRelease stuck in a hung install/upgrade action
(e.g. "Running 'install' action" forever, with no pod activity).

Usage:
  scripts/unstuck <release> [options]
  scripts/unstuck --list

Arguments:
  <release>                 HelmRelease name

Options:
  -n, --namespace NS        Namespace (auto-detected if omitted)
  -l, --list                List HelmReleases that are not Ready
      --no-restart          Skip restarting the helm-controller
  -y, --yes                 Skip confirmation
  -h, --help                Show this help

Steps performed:
  1. suspend the HelmRelease (stops Flux from touching it)
  2. restart helm-controller (kills any hung install/upgrade goroutine)
  3. delete the release's helm storage secrets (clears pending-install state)
  4. resume the HelmRelease (triggers a fresh install)
EOF
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || { echo "Missing required command: $1" >&2; exit 1; }
}

log() { printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }

confirm_or_exit() {
  local prompt="$1" ans
  [[ "$ASSUME_YES" == "true" ]] && return 0
  read -r -p "$prompt [y/N]: " ans
  [[ "$ans" == "y" || "$ans" == "Y" ]] || { log "Refused; nothing was changed"; exit 1; }
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n|--namespace)
        [[ $# -ge 2 && "$2" != -* ]] || { echo "$1 requires a value" >&2; exit 1; }
        NAMESPACE="$2"; shift 2 ;;
      -l|--list) LIST_ONLY="true"; shift ;;
      --no-restart) NO_RESTART="true"; shift ;;
      -y|--yes) ASSUME_YES="true"; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) echo "Unknown argument: $1" >&2; usage >&2; exit 1 ;;
      *)
        [[ -z "$RELEASE" ]] || { echo "Only one <release> may be specified" >&2; exit 1; }
        RELEASE="$1"; shift ;;
    esac
  done
}

list_stuck() {
  log "HelmReleases that are not Ready:"
  kubectl get helmreleases -A \
    -o 'jsonpath={range .items[*]}{.metadata.namespace}{"/"}{.metadata.name}{"\t"}{.status.conditions[?(@.type=="Ready")].status}{"\t"}{.status.conditions[?(@.type=="Ready")].message}{"\n"}{end}' \
    2>/dev/null | awk -F'\t' '$2 != "True" {printf "  %-34s %s\n", $1, $3}'
}

resolve_namespace() {
  local release="$1" matches count
  [[ -n "$NAMESPACE" ]] && return 0
  matches="$(kubectl get helmreleases -A \
    -o 'jsonpath={range .items[*]}{.metadata.namespace}{"\t"}{.metadata.name}{"\n"}{end}' \
    2>/dev/null | awk -F'\t' -v r="$release" '$2 == r {print $1}')"
  count="$(printf '%s\n' "$matches" | grep -c . || true)"
  if [[ "$count" -eq 0 ]]; then
    echo "HelmRelease '$release' not found in any namespace" >&2
    return 1
  elif [[ "$count" -gt 1 ]]; then
    echo "HelmRelease '$release' exists in multiple namespaces: $(printf '%s' "$matches" | tr '\n' ' ')" >&2
    echo "Specify one with --namespace" >&2
    return 1
  fi
  NAMESPACE="$matches"
}

unstick() {
  local release="$1" ns="$2" ready
  if ! kubectl get helmrelease "$release" -n "$ns" >/dev/null 2>&1; then
    echo "HelmRelease '$release' not found in namespace '$ns'" >&2
    return 1
  fi
  ready="$(kubectl get helmrelease "$release" -n "$ns" -o 'jsonpath={.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null || true)"
  log "HelmRelease $ns/$release (Ready=${ready:-<none>})"

  local prompt
  if [[ "$NO_RESTART" == "true" ]]; then
    prompt="Clear the helm release state for $ns/$release (suspend -> delete storage secrets -> resume)?"
  else
    prompt="Restart helm-controller AND clear $ns/$release (suspend -> restart controller -> delete storage secrets -> resume)?"
  fi
  confirm_or_exit "$prompt"

  log "[1/4] suspending HelmRelease $ns/$release"
  kubectl patch helmrelease "$release" -n "$ns" --type=merge -p '{"spec":{"suspend":true}}' >/dev/null

  if [[ "$NO_RESTART" != "true" ]]; then
    log "[2/4] restarting $CONTROLLER in $FLUX_NS"
    kubectl -n "$FLUX_NS" rollout restart "deployment/$CONTROLLER"
    kubectl -n "$FLUX_NS" rollout status "deployment/$CONTROLLER" --timeout=120s
  else
    log "[2/4] skipping helm-controller restart (--no-restart)"
  fi

  log "[3/4] deleting helm storage secrets for $ns/$release"
  kubectl delete secret -n "$ns" -l "owner=helm,name=$release" --ignore-not-found

  log "[4/4] resuming HelmRelease $ns/$release"
  kubectl patch helmrelease "$release" -n "$ns" --type=merge -p '{"spec":{"suspend":false}}' >/dev/null

  log "Done. Watch with: kubectl get helmrelease $release -n $ns; kubectl get pods -n $ns -w"
}

main() {
  require_cmd kubectl
  parse_args "$@"
  if [[ "$LIST_ONLY" == "true" ]]; then
    list_stuck
    return 0
  fi
  [[ -n "$RELEASE" ]] || { echo "Missing <release> argument" >&2; usage >&2; exit 1; }
  resolve_namespace "$RELEASE" || exit 1
  unstick "$RELEASE" "$NAMESPACE"
}

main "$@"
